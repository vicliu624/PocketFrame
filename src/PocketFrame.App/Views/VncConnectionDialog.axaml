<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PocketFrame.App.Views.VncConnectionDialog"
        Title="VNC Connections"
        Width="560"
        Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#f7f7f7"
        RequestedThemeVariant="Light">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <Grid ColumnDefinitions="180,*">
      <Border BorderBrush="#3a4354" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Saved Connections" FontWeight="SemiBold" Margin="8" />
          <ListBox x:Name="ProfilesList" Margin="8,0,8,8" SelectionChanged="OnProfileSelectionChanged" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="110,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="Device" VerticalAlignment="Center" />
        <ComboBox x:Name="DeviceBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="Host" VerticalAlignment="Center" />
        <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Text="Port" VerticalAlignment="Center" />
        <NumericUpDown x:Name="PortBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Minimum="1" Maximum="65535" Increment="1" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Text="Password" VerticalAlignment="Center" />
        <TextBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" PasswordChar="*" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,10,0,0" Text="Scale" VerticalAlignment="Center" />
        <ComboBox x:Name="ScaleBox" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" />

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Content="New" Click="OnNewClick" />
          <Button Content="Save" Click="OnSaveClick" />
          <Button Content="Delete" Click="OnDeleteClick" />
        </StackPanel>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="Connect" Classes="accent" Click="OnConnectClick" />
    </StackPanel>
  </Grid>
</Window>
