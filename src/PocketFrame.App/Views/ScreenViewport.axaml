<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PocketFrame.App.Views"
             x:Class="PocketFrame.App.Views.ScreenViewport"
             ClipToBounds="True"
             Focusable="True">
  <Border BorderBrush="#1bc7ff" BorderThickness="1" Background="#05070a" ClipToBounds="True">
    <Grid>
      <views:VncFramebufferView Framebuffer="{Binding Vnc.Framebuffer}"
                                FrameVersion="{Binding Vnc.FrameVersion}" />
      <TextBlock Text="VNC framebuffer" Foreground="#70ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Vnc.ShowPlaceholder}" />
    </Grid>
  </Border>
</UserControl>
