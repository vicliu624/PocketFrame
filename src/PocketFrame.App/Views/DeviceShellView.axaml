<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PocketFrame.App.Views.DeviceShellView"
             Focusable="True"
             Background="#121722">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#121722">
    <Border Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentControl x:Name="ShellHost" />
    </Border>
  </ScrollViewer>
</UserControl>
